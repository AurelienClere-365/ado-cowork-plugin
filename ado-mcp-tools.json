      "description": "List all Azure DevOps projects in the organisation.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "wit_get_work_item",
      "description": "Get a work item by ID including fields, relations and comments.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "description": "Project name or ID."
          },
          "id": {
            "type": "integer",
            "description": "Work item ID."
          }
        },
        "required": [
          "project",
          "id"
        ],
        "additionalProperties": false
      }
    },
